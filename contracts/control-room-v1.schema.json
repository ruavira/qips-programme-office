{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qips.example/contracts/control-room-v1.schema.json",
  "title": "QIPS Programme Office control-room snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "workstreams", "decisions", "facts", "documents", "dossiers"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_of_truth", "programme", "workstream_count"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "source_of_truth": {"const": "github"},
        "programme": {"const": "QIPS Programme Office"},
        "workstream_count": {"const": 17}
      }
    },
    "workstreams": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {"$ref": "#/$defs/workstream"}
    },
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
    "dossiers": {"type": "array", "items": {"$ref": "#/$defs/dossier"}}
  },
  "$defs": {
    "workstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "title", "directorate", "cluster", "state", "status", "health", "cohort", "progress", "question", "outputs", "dependencies", "blocking_questions"],
      "properties": {
        "code": {"type": "string", "pattern": "^W(0[1-9]|1[0-7])$"},
        "title": {"type": "string"},
        "directorate": {"enum": ["D1", "D2", "D3", "D4"]},
        "cluster": {"type": "string"},
        "state": {"type": "string"},
        "status": {"enum": ["not_started", "in_discovery", "in_design", "in_review", "decision_required", "approved", "blocked"]},
        "health": {"enum": ["on_track", "attention", "blocked"]},
        "cohort": {"enum": ["cohort_1", "cohort_2", "later"]},
        "progress": {"type": "integer", "minimum": 0, "maximum": 100},
        "question": {"type": "string"},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "blocking_questions": {"type": "array", "items": {"type": "string"}
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["decision_id", "question", "owner", "blocking", "status"],
      "properties": {
        "decision_id": {"type": "string"},
        "question": {"type": "string"},
        "owner": {"type": "string"},
        "blocking": {"type": "boolean"},
        "status": {"type": "string"},
        "blocks": {"type": "array", "items": {"type": "string"}},
        "due_date": {"type": ["string", "null"]},
        "note": {"type": ["string", "null"]}
      }
    },
    "fact": {
      "type": "object",
      "required": ["fact_id", "statement", "status", "owner"],
      "properties": {
        "fact_id": {"type": "string"},
        "statement": {"type": "string"},
        "status": {"enum": ["APPROVED", "PROPOSED", "SUPERSEDED"]},
        "owner": {"type": "string"},
        "source": {"type": ["string", "null"]},
        "established": {"type": ["string", "null"]}
      }
    },
    "document": {
      "type": "object",
      "required": ["document_id", "title", "owner", "status"],
      "properties": {
        "document_id": {"type": "string"},
        "title": {"type": "string"},
        "owner": {"type": "string"},
        "status": {"type": "string"},
        "version": {"type": ["string", "null"]},
        "repository_source": {"type": ["string", "null"]},
        "drive_url": {"type": ["string", "null"]}
      }
    },
    "dossier": {
      "type": "object",
      "required": ["dossier_id", "workstream", "path"],
      "properties": {
        "dossier_id": {"type": "string"},
        "workstream": {"type": "string"},
        "path": {"type": "string"},
        "status": {"type": "string"}
      }
    }
  }
}
